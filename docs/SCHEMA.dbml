Project VibaAI {
  database_type: 'MySQL'
  Note: 'Database schema for AI-powered sign language platform.'
}

Table users {
  id integer [primary key, increment]
  name varchar [not null]
  email varchar [unique, not null]
  google_id varchar [unique, null]
  role varchar [note: 'Enum: student, teacher, corporate']
  stars integer [default: 0]
  created_at timestamp
  updated_at timestamp
}

Table modules {
  id integer [primary key, increment]
  title varchar [not null]
  description text
  is_active boolean [default: true]
  created_at timestamp
  updated_at timestamp
}

Table quests {
  id integer [primary key, increment]
  module_id integer [ref: > modules.id]
  title varchar [not null]
  reward_stars integer [default: 10]
  is_active boolean [default: true]
  created_at timestamp
  updated_at timestamp
}